{
  "manifest_version": 3,
  "name": "VaultTabs — Crash-Proof Session Manager",
  "short_name": "VaultTabs",
  "description": "Crash-proof Chrome tab and Tab Group session manager that preserves group colors without duplicating groups on restore.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VaultTabs",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ]
}
